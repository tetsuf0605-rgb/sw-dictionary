{
  "name": "sw-dictionary",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "predev": "npm run data:build",
    "dev": "vite",
    "prebuild": "npm run data:build",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "test": "vitest run --passWithNoTests",
    "test:watch": "vitest",
    "lint": "oxlint",
    "data:validate": "node scripts/validate-data.mjs",
    "data:build": "node scripts/validate-data.mjs && node scripts/build-db.mjs",
    "data:preview": "node scripts/preview.mjs",
    "icons": "node scripts/make-icons.mjs"
  },
  "dependencies": {
    "lucide-react": "^1.65.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-router-dom": "^7.18.5"
  },
  "devDependencies": {
    "@types/node": "^24.19.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "oxlint": "^1.89.0",
    "typescript": "~7.0.2",
    "vite": "^8.3.5",
    "vite-plugin-pwa": "^2.0.0",
    "vitest": "^5.0.5"
  }
}
