[
  {
    "id": "cad-bane",
    "type": "character",
    "names": [
      { "text": "キャド・ベイン", "reading": "きゃど・べいん", "en": "Cad Bane" }
    ],
    "facts": [
      { "kind": "summary", "text": "つば広の帽子をかぶった青い肌の賞金稼ぎ。金のためなら何でも請け負う。", "revealedBy": ["tcw-s1", "tcw-s2", "boba-fett"] },
      { "text": "二丁の銃を素早く抜き、腕ずくの仕事も厭わない。", "revealedBy": ["tcw-s1", "tcw-s2"] },
      { "text": "[[galactic-senate]]の議場に乗り込んで議員を人質に取り、[[ziro-the-hutt]]を牢から出させた。", "revealedBy": ["tcw-s1"] },
      { "text": "[[count-dooku]]に雇われて動いた。", "revealedBy": ["tcw-s2"] },
      { "text": "[[jedi|ジェダイ]]の神殿に忍び込み、[[holocron]]を盗み出した。", "revealedBy": ["tcw-s2"] },
      { "text": "[[the-force]]の素質を持つ子どもをさらう仕事も請けた。", "revealedBy": ["tcw-s2"] }
    ]
  },
  {
    "id": "hondo-ohnaka",
    "type": "character",
    "names": [
      { "text": "ホンド・オナカ", "reading": "ほんど・おなか", "en": "Hondo Ohnaka" }
    ],
    "facts": [
      { "kind": "summary", "text": "[[florrum]]を根城にする海賊団の頭。", "revealedBy": ["tcw-s2"] },
      { "text": "金になるなら誰とでも取り引きし、敵にも味方にもなる。", "revealedBy": ["tcw-s2"] },
      { "text": "[[count-dooku]]を捕らえ、身代金を取ろうとした。", "revealedBy": ["tcw-s2"] },
      { "text": "身代金の受け渡しに来た[[anakin-skywalker]]と[[obi-wan-kenobi]]も一緒に閉じ込めた。", "revealedBy": ["tcw-s2"] }
    ]
  },
  {
    "id": "florrum",
    "type": "place",
    "names": [
      { "text": "フロールム", "reading": "ふろーるむ", "en": "Florrum" }
    ],
    "facts": [
      { "kind": "summary", "text": "[[hondo-ohnaka]]の海賊団が根城にする、荒れた土地の広がる星。", "revealedBy": ["tcw-s2"] },
      { "text": "[[galactic-republic]]にも[[separatists]]にも属さない。", "revealedBy": ["tcw-s2"] }
    ]
  },
  {
    "id": "mandalore",
    "type": "place",
    "names": [
      { "text": "マンダロア", "reading": "まんだろあ", "en": "Mandalore" }
    ],
    "facts": [
      { "kind": "summary", "text": "戦いの歴史を持つ星。今は戦いを捨て、中立を掲げている。", "revealedBy": ["tcw-s2", "tcw-s5", "tcw-s7"] },
      { "text": "透明な覆いに守られた都市があり、人々はその中で暮らす。", "revealedBy": ["tcw-s2"] },
      { "text": "[[satine-kryze]]が治めている。", "revealedBy": ["tcw-s2"] },
      { "text": "[[galactic-republic]]にも[[separatists]]にもつかない道を選んでいた。", "revealedBy": ["tcw-s2"] },
      { "text": "昔ながらの戦士の道に戻そうとする[[death-watch]]が暗躍していた。", "revealedBy": ["tcw-s2"] }
    ]
  },
  {
    "id": "satine-kryze",
