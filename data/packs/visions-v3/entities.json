[
  {
    "id": "teto",
    "type": "character",
    "names": [
      { "text": "テト", "reading": "てと", "en": "Teto" }
    ],
    "facts": [
      { "kind": "summary", "text": "見捨てられた船を守り続けていた、目の大きな小さなドロイド。", "revealedBy": ["visions-v3"] },
      { "text": "漂っていた[[lah-kara]]を拾い上げ、助けた。", "revealedBy": ["visions-v3"] },
      { "text": "主を治療槽に残したまま、何百年も待っていた。", "revealedBy": ["visions-v3"] },
      { "text": "倒れた像に道をふさがれ、主に会えなくなっていた。", "revealedBy": ["visions-v3"] },
      { "text": "主がすでに亡いと知らされても、会わせてくれた礼を言った。", "revealedBy": ["visions-v3"] },
      { "text": "[[lah-kara]]に汁物を作って食べさせた。", "revealedBy": ["visions-v3"] },
      { "text": "脱出艇に彼女を押し込み、残った力を使い切って送り出した。", "revealedBy": ["visions-v3"] },
      { "text": "「君は銀河の最後の望みだ」と言い残し、船ごと果てた。", "revealedBy": ["visions-v3"] }
    ]
  },
  {
    "id": "nawaam",
    "type": "character",
    "names": [
      { "text": "ナワーム", "reading": "なわーむ", "en": "Nawaam" }
    ],
    "facts": [
      { "kind": "summary", "text": "面をつけた将。ジェダイを根絶やしにしようとしている。", "revealedBy": ["visions-v3", "visions-ninth-jedi"] },
      { "text": "ジェダイ一人に一億の懸賞をかけ、追っ手を各地に放った。", "revealedBy": ["visions-v3"] },
      { "text": "戦乱の世に現れた覇者の一人で、星を次々に従わせていた。", "revealedBy": ["visions-ninth-jedi"] },
      { "text": "[[sith-acolytes|シスの徒]]と手を結び、追っ手を手足のように使った。", "revealedBy": ["visions-ninth-jedi"] },
      { "text": "少年の日に[[lah-zhima]]の剣さばきを見て、その「無」の境地に魅せられた。", "revealedBy": ["visions-ninth-jedi"] },
      { "text": "そのとき倒れた師の剣を拾い、自分のものにした。", "revealedBy": ["visions-ninth-jedi"] },
      { "text": "光と闇の区別を「古くさい戯言」と呼び、両方を受け入れよと説いた。", "revealedBy": ["visions-ninth-jedi"] },
      { "text": "[[lah-kara]]の前で己の刃が赤く染まり、敗れた。", "revealedBy": ["visions-ninth-jedi"] }
    ]
  },
  {
    "id": "bee-toh",
    "type": "character",
    "names": [
      { "text": "ビー・トー", "reading": "びー・とー", "en": "Bee-Toh" }
    ],
    "facts": [
      { "kind": "summary", "text": "もとは[[jedi-hunters|ジェダイ・ハンター]]だった男。", "revealedBy": ["visions-v3", "visions-ninth-jedi"] },
      { "text": "[[lah-zhima]]を捕らえたのはこの者だった。", "revealedBy": ["visions-v3"] },
      { "text": "のちに追っ手の側を離れ、[[lah-kara]]たちと共に戦った。", "revealedBy": ["visions-ninth-jedi"] },
      { "text": "銃と剣の両方を使う。", "revealedBy": ["visions-ninth-jedi"] },
      { "text": "巨大な結晶を銃で撃ち、赤い光の束を噴き出させてしまった。", "revealedBy": ["visions-ninth-jedi"] }
    ]
  },
  {
    "id": "anda",
    "type": "character",
    "names": [
      { "text": "アンダ", "reading": "あんだ", "en": "Anda" }
    ],
    "facts": [
      { "kind": "summary", "text": "[[jedi-hunters|ジェダイ・ハンター]]の船を率いる男。", "revealedBy": ["visions-v3"] },
      { "text": "相棒のウンダと組み、飛ぶ刃物を投げて戦う。", "revealedBy": ["visions-v3"] },
      { "text": "[[lah-kara]]を生け捕りにして、仲間を誘い出そうとした。", "revealedBy": ["visions-v3"] },
      { "text": "[[teto]]の船に乗り込み、脱出艇を取り逃がした。", "revealedBy": ["visions-v3"] }
    ]
  },
  {
    "id": "grand-master",
    "type": "character",
    "names": [
      { "text": "グランド・マスター", "reading": "ぐらんど・ますたー", "en": "The Grand Master" }
    ],
    "facts": [
      { "kind": "summary", "text": "ジェダイを率いながら、仇討ちに取り憑かれた者。", "revealedBy": ["visions-v3"] },
      { "text": "手下を各地に放ち、[[ronin]]の行方を探らせていた。", "revealedBy": ["visions-v3"] },
      { "text": "居場所が割れると、自ら一人乗りの船で向かった。", "revealedBy": ["visions-v3"] }
    ]
  },
  {
    "id": "princess-crane",
    "type": "character",
    "names": [
      { "text": "クレイン", "reading": "くれいん", "en": "Crane" }
    ],
    "facts": [
      { "kind": "summary", "text": "姫の身分を捨てて、抗う側に加わった女。", "revealedBy": ["visions-v3"] },
      { "text": "「姫と呼ぶな」と言って、偵察の役を買って出た。", "revealedBy": ["visions-v3"] },
      { "text": "昔の暮らしの名残である小さなドロイドを連れている。", "revealedBy": ["visions-v3"] },
      { "text": "雪の星で、追われる子を守って立った。", "revealedBy": ["visions-v3"] }
    ]
  },
  {
    "id": "sevn",
    "type": "character",
    "names": [
      { "text": "セヴン", "reading": "せぶん", "en": "Sevn" }
    ],
    "facts": [
      { "kind": "summary", "text": "どこにも属さない賞金稼ぎの女。", "revealedBy": ["visions-v3"] },
      { "text": "顔の左に傷がある。幼い日に、剣を持つ者に家を焼かれた。", "revealedBy": ["visions-v3"] },
      { "text": "相棒のドロイドに「暗殺の仕掛け」を入れてしまったことを悔いている。", "revealedBy": ["visions-v3"] },
      { "text": "怪しい商人の仕事を請け、思わぬ結末を招いた。", "revealedBy": ["visions-v3"] }
    ]
  },
  {
    "id": "yuko",
    "type": "character",
    "names": [
      { "text": "ユウコ", "reading": "ゆうこ", "en": "Yuko" }
    ],
    "facts": [
      { "kind": "summary", "text": "親を失い、ドロイドに育てられている少年。", "revealedBy": ["visions-v3"] },
      { "text": "熊の形をしたドロイドが、親の代わりに世話をしていた。", "revealedBy": ["visions-v3"] },
      { "text": "そのドロイドを連れ去られ、街の子と組んで取り返しに行った。", "revealedBy": ["visions-v3"] },
      { "text": "探す道の先に、長く失われていた宝があった。", "revealedBy": ["visions-v3"] }
    ]
  },
  {
    "id": "chita",
    "type": "character",
    "names": [
      { "text": "チータ", "reading": "ちーた", "en": "Chita" }
    ],
    "facts": [
      { "kind": "summary", "text": "桃色の髪をした密輸屋。", "revealedBy": ["visions-v3"] },
      { "text": "船の代金を払えず、自分の船を押さえられていた。", "revealedBy": ["visions-v3"] },
      { "text": "金に詰まり、帝国から逃げる者を助け出す仕事を請けた。", "revealedBy": ["visions-v3"] },
      { "text": "その相手は、滅ぼされた王家にただ一人残った者だった。", "revealedBy": ["visions-v3"] }
    ]
  },
  {
    "id": "nakime",
    "type": "character",
    "names": [
      { "text": "ナキメ", "reading": "なきめ", "en": "Nakime" }
    ],
    "facts": [
      { "kind": "summary", "text": "気の短いジェダイの弟子。", "revealedBy": ["visions-v3"] },
      { "text": "シスとの戦いで両の目を焼かれ、谷底へ落ちた。", "revealedBy": ["visions-v3"] },
      { "text": "見えないまま、幾日もの試しを一人で越えていった。", "revealedBy": ["visions-v3"] },
      { "text": "暗黒面の誘いを退けることが、その試しだった。", "revealedBy": ["visions-v3"] }
    ]
  }
]
