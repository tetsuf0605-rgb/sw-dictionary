  {
    "id": "galactic-empire",
    "facts": [
      { "text": "小さな反抗を口実に、各地の締めつけを強めた。", "revealedBy": ["andor-s1"] },
      { "text": "罪を重くして人を監獄へ送り、ただ働きをさせた。", "revealedBy": ["andor-s1"] }
    ]
  },
  {
    "id": "rebel-alliance",
