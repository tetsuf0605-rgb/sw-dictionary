      { "text": "もとはジェダイだった者も含まれている。", "revealedBy": ["obi-wan"] },
      { "text": "[[darth-vader]]の下に置かれている。", "revealedBy": ["obi-wan"] }
    ]
  },
  {
    "id": "grand-inquisitor",
    "type": "character",
    "names": [
