[
  {
    "id": "din-djarin",
    "type": "character",
    "names": [
      { "text": "ディン・ジャリン", "reading": "でぃん・じゃりん", "en": "Din Djarin" },
      { "text": "マンダロリアン", "reading": "まんだろりあん", "en": "The Mandalorian", "revealedBy": ["mando-s1"], "kind": "alias" }
    ],
    "facts": [
      { "kind": "summary", "text": "顔を人に見せない賞金稼ぎ。[[beskar]]の甲冑を身につけている。", "revealedBy": ["mando-s1", "mando-s2", "boba-fett", "mando-s3"] },
      { "text": "幼いころ戦火で親を失い、[[the-way|掟]]を守る者たちに育てられた。", "revealedBy": ["mando-s1"] },
      { "text": "一度かぶった兜を、人前では決して脱がない。", "revealedBy": ["mando-s1"] },
      { "text": "引き渡した[[the-child]]を連れ戻し、追われる身になった。", "revealedBy": ["mando-s1"] },
      { "text": "名を明かすことは、めったにない。", "revealedBy": ["mando-s1"] }
    ]
  },
  {
    "id": "the-child",
    "type": "character",
    "names": [
      { "text": "ザ・チャイルド", "reading": "ざ・ちゃいるど", "en": "The Child" }
    ],
    "facts": [
      { "kind": "summary", "text": "揺りかごに乗せられた、大きな耳と丸い目の幼子。", "revealedBy": ["mando-s1", "mando-s2"] },
      { "text": "50年を生きているが、見た目はまだ幼い。", "revealedBy": ["mando-s1"] },
      { "text": "[[the-force]]の力を使い、物を浮かせたり傷を癒やしたりする。", "revealedBy": ["mando-s1"] },
      { "text": "帝国の残党に追われていた。", "revealedBy": ["mando-s1"] },
      { "text": "[[din-djarin]]が預かることになった。", "revealedBy": ["mando-s1"] },
      { "text": "名は明かされないままだった。", "revealedBy": ["mando-s1"] }
    ]
  },
  {
    "id": "ig-11",
    "type": "character",
    "names": [
      { "text": "IG-11", "reading": "あいじーいれぶん", "en": "IG-11" }
    ],
    "facts": [
      { "kind": "summary", "text": "細身の賞金稼ぎのドロイド。", "revealedBy": ["mando-s1", "mando-s3"] },
      { "text": "捕らえられそうになると、自らを壊すよう作られている。", "revealedBy": ["mando-s1"] },
      { "text": "[[kuiil]]に組み直され、守り手として動くようになった。", "revealedBy": ["mando-s1"] },
      { "text": "[[the-child]]たちを守るために、自ら壊れた。", "revealedBy": ["mando-s1"] }
    ]
  },
  {
    "id": "kuiil",
    "type": "character",
    "names": [
      { "text": "クイール", "reading": "くいーる", "en": "Kuiil" }
    ],
    "facts": [
      { "kind": "summary", "text": "[[din-djarin]]に手を貸した、辺境に暮らす老人。", "revealedBy": ["mando-s1"] },
      { "text": "長く帝国に使われ、年季を終えて自由になった。", "revealedBy": ["mando-s1"] },
      { "text": "言いたいことを言い終えると、決まった一言で話を締める。", "revealedBy": ["mando-s1"] },
      { "text": "ドロイドを直すことに長けていた。", "revealedBy": ["mando-s1"] },
      { "text": "帝国の兵に撃たれた。", "revealedBy": ["mando-s1"] }
    ]
  },
  {
    "id": "cara-dune",
    "type": "character",
    "names": [
      { "text": "カラ・デューン", "reading": "から・でゅーん", "en": "Cara Dune" }
    ],
    "facts": [
      { "kind": "summary", "text": "元は[[rebel-alliance|反乱軍]]の兵だった女。", "revealedBy": ["mando-s1"] },
      { "text": "戦いが終わったあと、行き場をなくしていた。", "revealedBy": ["mando-s1"] },
      { "text": "腕っぷしが強く、重い銃を扱う。", "revealedBy": ["mando-s1"] },
      { "text": "[[din-djarin]]と組むようになった。", "revealedBy": ["mando-s1"] }
    ]
  },
  {
    "id": "greef-karga",
    "type": "character",
    "names": [
      { "text": "グリーフ・カルガ", "reading": "ぐりーふ・かるが", "en": "Greef Karga" }
