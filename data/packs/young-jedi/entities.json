[
  {
    "id": "kai-brightstar",
    "type": "character",
    "names": [
      { "text": "カイ・ブライトスター", "reading": "かい・ぶらいとすたー", "en": "Kai Brightstar" }
    ],
    "facts": [
      { "kind": "summary", "text": "[[tenoo]]で修行する、幼い[[jedi|ジェダイ]]の弟子。", "revealedBy": ["young-jedi"] },
      { "text": "[[lys-solay]]と[[nubs]]と、いつも三人で動いている。", "revealedBy": ["young-jedi"] },
      { "text": "何でも一人でやろうとして、友に支えられることが多い。", "revealedBy": ["young-jedi"] },
      { "text": "[[taborr-val-dorn]]に剣を盗まれたことがある。", "revealedBy": ["young-jedi"] },
      { "text": "「暗いときでも、光は守る値打ちがある」と[[tenoo]]から呼びかけた。", "revealedBy": ["young-jedi"] },
      { "text": "寺院を奪われたとき、残った弟子たちの先に立った。", "revealedBy": ["young-jedi"] }
    ]
  },
  {
    "id": "lys-solay",
    "type": "character",
    "names": [
      { "text": "リス・ソレイ", "reading": "りす・それい", "en": "Lys Solay" }
    ],
    "facts": [
      { "kind": "summary", "text": "[[tenoo]]で修行する、肌の青いパントーランの弟子。", "revealedBy": ["young-jedi"] },
      { "text": "生き物の扱いに長け、よく手当てをしている。", "revealedBy": ["young-jedi"] },
      { "text": "「ジェダイは、大きかろうと小さかろうと困っている生き物を助ける」と言う。", "revealedBy": ["young-jedi"] },
      { "text": "[[kai-brightstar]]に「一人でやらなくていい、友はそのためにいる」と言った。", "revealedBy": ["young-jedi"] }
    ]
  },
  {
    "id": "nubs",
    "type": "character",
    "names": [
      { "text": "ナブス", "reading": "なぶす", "en": "Nubs" }
    ],
    "facts": [
      { "kind": "summary", "text": "毛むくじゃらで小さいが、弟子の中で一番力の強い子。", "revealedBy": ["young-jedi"] },
      { "text": "プーバという種族で、共通の言葉は話さない。", "revealedBy": ["young-jedi"] },
      { "text": "言いたいことは、[[kai-brightstar]]と[[lys-solay]]が言い添えてくれる。", "revealedBy": ["young-jedi"] },
      { "text": "食べることが大好きで、食事の機会を逃さない。", "revealedBy": ["young-jedi"] }
    ]
  },
  {
    "id": "nash-durango",
    "type": "character",
    "names": [
      { "text": "ナッシュ・デュランゴ", "reading": "なっしゅ・でゅらんご", "en": "Nash Durango" }
    ],
    "facts": [
      { "kind": "summary", "text": "[[tenoo]]育ちの少女操縦士。機械いじりも得意。", "revealedBy": ["young-jedi"] },
      { "text": "親が営む輸送屋を手伝い、[[crimson-firehawk]]で荷と人を運ぶ。", "revealedBy": ["young-jedi"] },
      { "text": "[[rj-83]]を副操縦士と呼んでいる。", "revealedBy": ["young-jedi"] },
      { "text": "[[coruscant]]から送られてきた弟子たちを[[tenoo]]へ運び、そのまま友になった。", "revealedBy": ["young-jedi"] },
      { "text": "[[jedi|ジェダイ]]ではないが、三人の冒険にはいつも付き合っている。", "revealedBy": ["young-jedi"] }
    ]
  },
  {
    "id": "rj-83",
    "type": "character",
    "names": [
      { "text": "RJ-83", "reading": "あーるじぇー・えいてぃーすりー", "en": "RJ-83" }
    ],
    "facts": [
      { "kind": "summary", "text": "[[nash-durango]]の相棒のドロイド。", "revealedBy": ["young-jedi"] },
      { "text": "船の手入れと操縦の手伝いをする。", "revealedBy": ["young-jedi"] },
      { "text": "[[nash-durango]]と一緒に、船の手直しを進めている。", "revealedBy": ["young-jedi"] }
    ]
  },
  {
    "id": "zia-zaldor-zanna",
    "type": "character",
    "names": [
      { "text": "ジーア・ザルドール・ザナ", "reading": "じーあ・ざるどーる・ざな", "en": "Zia Zaldor Zanna" }
    ],
    "facts": [
      { "kind": "summary", "text": "[[tenoo]]の寺院で幼い弟子を教える[[jedi|ジェダイ]]・マスター。", "revealedBy": ["young-jedi"] },
      { "text": "「誰の中にも光がある。互いにそれを見つけ合うのがジェダイの仕事」と教えた。", "revealedBy": ["young-jedi"] },
      { "text": "人を助けた弟子を、まっすぐに褒める。", "revealedBy": ["young-jedi"] },
      { "text": "[[wes-vinik]]を弟子として連れている。", "revealedBy": ["young-jedi"] }
    ]
  },
  {
    "id": "wes-vinik",
    "type": "character",
    "names": [
      { "text": "ウェス・ヴィニック", "reading": "うぇす・びにっく", "en": "Wes Vinik" }
    ],
    "facts": [
      { "kind": "summary", "text": "[[zia-zaldor-zanna]]の弟子である[[padawan|パダワン]]。", "revealedBy": ["young-jedi"] },
      { "text": "幼い弟子たちより年上で、兄弟子として頼られている。", "revealedBy": ["young-jedi"] },
      { "text": "ハット語を話せ、もめ事を言葉でおさめたことがある。", "revealedBy": ["young-jedi"] },
      { "text": "寺院を奪われたとき、弟子たちをまとめて反撃に出た。", "revealedBy": ["young-jedi"] }
    ]
  },
  {
    "id": "taborr-val-dorn",
    "type": "character",
    "names": [
      { "text": "タボール・ヴァル＝ドーン", "reading": "たぼーる・ばるどーん", "en": "Taborr Val Dorn" },
      { "text": "サイラス・ヴーンディア", "reading": "さいらす・ぶーんでぃあ", "en": "Cyrus Vuundir", "kind": "alias", "revealedBy": ["young-jedi"] }
    ],
    "facts": [
      { "kind": "summary", "text": "[[tenoo]]のあたりを荒らす、少年の海賊。", "revealedBy": ["young-jedi"] },
      { "text": "[[pord]]と[[eb-3]]を手下にしている。", "revealedBy": ["young-jedi"] },
      { "text": "[[hap]]の店を繰り返し襲い、[[kai-brightstar]]たちと度々ぶつかった。", "revealedBy": ["young-jedi"] },
      { "text": "本当はヴーンダラという星の王子で、親に隠れて海賊をしていた。", "revealedBy": ["young-jedi"] },
      { "text": "素性を隠したまま、弟子たちと友になったこともある。", "revealedBy": ["young-jedi"] },
      { "text": "[[ganguls|ガングル団]]とは互いに敵で、船を奪われかけたこともある。", "revealedBy": ["young-jedi"] },
      { "text": "寺院が奪われたときは、手下を連れて弟子たちの側に加わった。", "revealedBy": ["young-jedi"] }
    ]
  },
  {
    "id": "pord",
    "type": "character",
    "names": [
      { "text": "ポード", "reading": "ぽーど", "en": "Pord" }
    ],
    "facts": [
      { "kind": "summary", "text": "[[taborr-val-dorn]]の手下である、若いガモーリアン。", "revealedBy": ["young-jedi"] },
      { "text": "力仕事と、盗んだ荷の運び出しを任されている。", "revealedBy": ["young-jedi"] },
      { "text": "市場で果物を盗んだこともある。", "revealedBy": ["young-jedi"] }
    ]
  },
  {
    "id": "eb-3",
    "type": "character",
    "names": [
      { "text": "EB-3", "reading": "いーびー・すりー", "en": "EB-3" }
    ],
    "facts": [
      { "kind": "summary", "text": "[[taborr-val-dorn]]の手下のドロイド。", "revealedBy": ["young-jedi"] },
      { "text": "見つかるとすぐに慌てる。", "revealedBy": ["young-jedi"] },
      { "text": "[[pord]]と組んで荷を運び出す役である。", "revealedBy": ["young-jedi"] }
