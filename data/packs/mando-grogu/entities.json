[
  {
    "id": "rotta",
    "type": "character",
    "names": [
      { "text": "ロッタ", "reading": "ろった", "en": "Rotta" }
    ],
    "facts": [
      { "kind": "summary", "text": "[[jabba-the-hutt]]の息子。", "revealedBy": ["tcw-film", "mando-grogu"] },
      { "text": "幼いころ攫われ、[[anakin-skywalker]]と[[ahsoka-tano]]に助け出された。", "revealedBy": ["tcw-film"] },
      { "text": "道中で病に倒れかけたが、父のもとへ送り返された。", "revealedBy": ["tcw-film"] },
      { "text": "大人になり、[[shakari]]の闘技場で剣闘士として人気を得ていた。", "revealedBy": ["mando-grogu"] },
      { "text": "父の影から出ることを望み、自分の力で名を上げようとしていた。", "revealedBy": ["mando-grogu"] },
      { "text": "[[hutt-twins|双子]]に命を狙われていた。父の跡取りだからである。", "revealedBy": ["mando-grogu"] },
      { "text": "[[din-djarin]]と闘技場で戦わされたが、のちに肩を並べて獣と戦った。", "revealedBy": ["mando-grogu"] },
      { "text": "最後は[[new-republic|新共和国]]に力を貸す道を選んだ。", "revealedBy": ["mando-grogu"] }
    ]
  },
  {
    "id": "janu",
    "type": "character",
    "names": [
      { "text": "ジャヌ", "reading": "じゃぬ", "en": "Janu" },
      { "text": "コマンダー・コイン", "reading": "こまんだー・こいん", "en": "Commander Coin", "revealedBy": ["mando-grogu"] }
    ],
    "facts": [
      { "kind": "summary", "text": "[[shakari]]の裏を仕切る男。闘技場の主でもある。", "revealedBy": ["mando-grogu"] },
      { "text": "露店の商人から上納金を取り立てていた。", "revealedBy": ["mando-grogu"] },
      { "text": "[[rotta]]に自由を約束しながら、最後の試合で殺すつもりでいた。", "revealedBy": ["mando-grogu"] },
      { "text": "浜辺の屋敷を[[galactic-empire|帝国]]の兵に守らせていた。", "revealedBy": ["mando-grogu"] },
      { "text": "姿を見せない帝国の残党の指揮官と、同じ人物だった。", "revealedBy": ["mando-grogu"] },
      { "text": "[[din-djarin]]に捕らえられ、[[new-republic|新共和国]]に引き渡された。", "revealedBy": ["mando-grogu"] },
      { "text": "取り調べで、[[hutt-twins|双子]]が両方に情報を流していたことを明かした。", "revealedBy": ["mando-grogu"] }
    ]
  },
  {
    "id": "colonel-ward",
    "type": "character",
    "names": [
      { "text": "ウォード大佐", "reading": "うぉーどたいさ", "en": "Colonel Ward" }
    ],
    "facts": [
      { "kind": "summary", "text": "[[adelphi-base]]の戦闘機隊を率いる[[new-republic|新共和国]]の将校。", "revealedBy": ["mando-grogu"] },
      { "text": "[[din-djarin]]に、帝国の残党を狩る仕事を回していた。", "revealedBy": ["mando-grogu"] },
      { "text": "生け捕りにしろという指示を守らない[[din-djarin]]に、たびたび不満を漏らした。", "revealedBy": ["mando-grogu"] },
      { "text": "[[hutt-twins|双子]]との取り引きを進めていたが、裏切りに気づいた。", "revealedBy": ["mando-grogu"] },
      { "text": "「新共和国は味方を置いていかない」と言い、機隊を率いて助けに向かった。", "revealedBy": ["mando-grogu"] }
    ]
  },
  {
    "id": "hutt-twins",
    "type": "character",
    "names": [
      { "text": "ハットの双子", "reading": "はっとのふたご", "en": "The Twins" }
    ],
    "facts": [
      { "kind": "summary", "text": "[[nal-hutta]]の宮殿に座る、[[hutt|ハット]]の兄と妹。", "revealedBy": ["mando-grogu"] },
      { "text": "[[rotta]]の叔父と叔母にあたる。", "revealedBy": ["mando-grogu"] },
      { "text": "[[jabba-the-hutt]]の跡を継ぐために、その息子を消そうとしていた。", "revealedBy": ["mando-grogu"] },
      { "text": "[[new-republic|新共和国]]に帝国の残党の情報を売りながら、残党にも新共和国の動きを売っていた。", "revealedBy": ["mando-grogu"] },
      { "text": "[[din-djarin]]を捕らえ、見せ物のように兜を剥いだ。", "revealedBy": ["mando-grogu"] },
      { "text": "宮殿の下の池で飼っていた獣に、自分たちが落ちて食われた。", "revealedBy": ["mando-grogu"] }
    ]
  },
  {
    "id": "embo",
    "type": "character",
    "names": [
      { "text": "エンボ", "reading": "えんぼ", "en": "Embo" }
    ],
    "facts": [
      { "kind": "summary", "text": "笠のような兜をかぶった賞金稼ぎ。", "revealedBy": ["tcw-s2", "mando-grogu"] },
      { "text": "クローン戦争のころ、雇われて農民の村を海賊から守ったことがある。", "revealedBy": ["tcw-s2"] },
      { "text": "兜は盾にも投げる武器にもなる。", "revealedBy": ["tcw-s2", "mando-grogu"] },
      { "text": "[[hutt-twins|双子]]に雇われ、[[din-djarin]]を狙った。", "revealedBy": ["mando-grogu"] },
      { "text": "[[keibu]]という獣を連れている。", "revealedBy": ["mando-grogu"] },
      { "text": "雨の夜に[[nevarro]]の家を襲い、[[din-djarin]]を網で捕らえた。", "revealedBy": ["mando-grogu"] },
      { "text": "雇い主が倒れたあとは、戦いを続けずに去った。", "revealedBy": ["mando-grogu"] }
    ]
  },
  {
    "id": "keibu",
    "type": "character",
    "names": [
      { "text": "ケイブ", "reading": "けいぶ", "en": "Keibu" }
