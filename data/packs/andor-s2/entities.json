[
  {
    "id": "ghorman",
    "type": "place",
    "names": [
      { "text": "ゴーマン", "reading": "ごーまん", "en": "Ghorman" }
    ],
    "facts": [
      { "kind": "summary", "text": "織物で知られる星。細い糸を吐く生き物を育てている。", "revealedBy": ["andor-s2"] },
      { "text": "帝国が地下の資源に目をつけた。", "revealedBy": ["andor-s2"] },
      { "text": "住民は誇り高く、帝国のやり方に抗い続けた。", "revealedBy": ["andor-s2"] },
      { "text": "広場で[[ghorman-massacre|惨劇]]が起きた。", "revealedBy": ["andor-s2"] }
    ]
  },
  {
    "id": "krennic",
    "type": "character",
    "names": [
      { "text": "クレニック", "reading": "くれにっく", "en": "Krennic" }
    ],
    "facts": [
      { "kind": "summary", "text": "帝国の大きな計画を率いる長官。白い外套を羽織る。", "revealedBy": ["andor-s2", "rogue-one"] },
      { "text": "[[ghorman]]から資源を取り出す筋道を立てた。", "revealedBy": ["andor-s2"] },
      { "text": "住民の抵抗を自ら仕組み、鎮圧の口実にした。", "revealedBy": ["andor-s2"] },
      { "text": "巨大な兵器のために、各地から材料を集めていた。", "revealedBy": ["andor-s2"] }
    ]
  },
  {
    "id": "k-2so",
    "type": "character",
    "names": [
