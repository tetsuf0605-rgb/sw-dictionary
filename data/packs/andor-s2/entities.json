    ],
    "facts": [
      { "kind": "summary", "text": "鹵獲され、反乱軍の手で組み直された帝国の大型ドロイド。", "revealedBy": ["andor-s2", "rogue-one"] },
      { "text": "歯に衣着せぬ物言いをする。", "revealedBy": ["andor-s2"] },
      { "text": "[[cassian-andor]]と組むようになった。", "revealedBy": ["andor-s2"] }
