      { "text": "屋根の上から撃ち下ろしたが、落とされた。", "revealedBy": ["tales-underworld"] }
    ]
  },
  {
    "id": "vance",
    "type": "character",
    "names": [
      { "text": "ヴァンス", "reading": "ばんす", "en": "Vance" }
