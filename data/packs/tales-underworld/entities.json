[
  {
    "id": "lyco-strata",
    "type": "character",
    "names": [
      { "text": "ライコ・ストラータ", "reading": "らいこ・すとらーた", "en": "Lyco Strata" }
    ],
    "facts": [
      { "kind": "summary", "text": "生き延びた若い[[jedi|ジェダイ]]の弟子。", "revealedBy": ["tales-underworld"] },
      { "text": "知り合いはみな死んだと語り、独りで身を隠していた。", "revealedBy": ["tales-underworld"] },
      { "text": "切符売りに心を操る術をかけようとして、失敗した。", "revealedBy": ["tales-underworld"] },
      { "text": "[[hidden-path|隠れ道]]を頼って、星を出ようとしていた。", "revealedBy": ["tales-underworld"] },
      { "text": "[[asajj-ventress]]に助けられ、こちらも彼女の命を救った。", "revealedBy": ["tales-underworld"] },
      { "text": "襲ってきた者たちの言葉を聞き取り、話し合いでおさめた。", "revealedBy": ["tales-underworld"] },
      { "text": "逃げる船に乗らず、[[asajj-ventress]]と共に残ることを選んだ。", "revealedBy": ["tales-underworld"] }
    ]
  },
  {
    "id": "quinlan-vos",
    "type": "character",
    "names": [
      { "text": "クインラン・ヴォス", "reading": "くいんらん・ぼす", "en": "Quinlan Vos" }
    ],
    "facts": [
      { "kind": "summary", "text": "[[asajj-ventress]]と深く関わりのあった[[jedi|ジェダイ]]。", "revealedBy": ["tales-underworld"] },
      { "text": "[[dathomir]]の地下へ彼女の遺体を運び、水に沈めて別れを告げた。", "revealedBy": ["tales-underworld"] },
      { "text": "「ずっと愛している」と言い残して去った。", "revealedBy": ["tales-underworld"] },
      { "text": "[[hidden-path|隠れ道]]を始めた者だと伝えられている。", "revealedBy": ["tales-underworld"] },
      { "text": "生き返った[[asajj-ventress]]は、この男を探して旅に出た。", "revealedBy": ["tales-underworld"] }
    ]
  },
  {
    "id": "hidden-path",
    "type": "organization",
    "names": [
      { "text": "隠れ道", "reading": "かくれみち", "en": "Hidden Path" }
    ],
    "facts": [
      { "kind": "summary", "text": "[[the-force|フォース]]を使える者を、安全な場所へ逃がすための人づての道。", "revealedBy": ["obi-wan", "tales-underworld"] },
      { "text": "各地に隠れ家と合図があり、案内役が人を導いた。", "revealedBy": ["obi-wan"] },
      { "text": "[[obi-wan-kenobi]]も、この道の者たちに助けられた。", "revealedBy": ["obi-wan"] },
      { "text": "[[quinlan-vos]]が始めたと伝えられている。", "revealedBy": ["tales-underworld"] },
      { "text": "場所は地図に載らず、口伝えでしか辿れない。", "revealedBy": ["tales-underworld"] },
      { "text": "行き先を知る者は、裏社会でそれを高く売った。", "revealedBy": ["tales-underworld"] }
    ]
  },
  {
    "id": "latts-razzi",
    "type": "character",
    "names": [
      { "text": "ラッツ・ラジ", "reading": "らっつ・らじ", "en": "Latts Razzi" }
    ],
    "facts": [
      { "kind": "summary", "text": "肌の紫がかった賞金稼ぎの女。", "revealedBy": ["tales-underworld"] },
      { "text": "伸びる縄のような道具で相手を縛り上げる。", "revealedBy": ["tales-underworld"] },
      { "text": "[[c-21-highsinger]]を相棒にしている。", "revealedBy": ["tales-underworld"] },
      { "text": "[[asajj-ventress]]とは古い顔見知りで、仕事を持ちかけた。", "revealedBy": ["tales-underworld"] },
      { "text": "帝国の盾の部品を盗み出す仕事を企てた。", "revealedBy": ["tales-underworld"] },
      { "text": "分け前のために[[asajj-ventress]]を裏切り、[[lyco-strata]]を売ろうとした。", "revealedBy": ["tales-underworld"] },
      { "text": "「私は金のために働く」と言い切る。", "revealedBy": ["tales-underworld"] }
    ]
  },
  {
    "id": "c-21-highsinger",
    "type": "character",
    "names": [
      { "text": "C-21 ハイシンガー", "reading": "しーとぅえんてぃわん・はいしんがー", "en": "C-21 Highsinger" }
    ],
    "facts": [
