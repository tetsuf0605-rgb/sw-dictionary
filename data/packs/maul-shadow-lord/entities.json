[
  {
    "id": "janix",
    "type": "place",
    "names": [
      { "text": "ジャニックス", "reading": "じゃにっくす", "en": "Janix" }
    ],
    "facts": [
      { "kind": "summary", "text": "帝国の目が届きにくい、中間星域の星。", "revealedBy": ["maul-shadow-lord"] },
      { "text": "高層の建物が立ち並ぶ大きな街がある。", "revealedBy": ["maul-shadow-lord"] },
      { "text": "裏社会がはびこり、地元の警備隊がそれを追っていた。", "revealedBy": ["maul-shadow-lord"] },
      { "text": "身を隠す[[jedi|ジェダイ]]の生き残りもいた。", "revealedBy": ["maul-shadow-lord"] },
      { "text": "[[darth-maul]]が力を取り戻す場に選んだ。", "revealedBy": ["maul-shadow-lord"] }
    ]
  },
  {
