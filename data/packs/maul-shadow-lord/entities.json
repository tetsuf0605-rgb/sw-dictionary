    "facts": [
      { "text": "連れ去られたのち、裏社会で力を取り戻そうとしていた。", "revealedBy": ["maul-shadow-lord"] },
      { "text": "[[janix]]で押し込みを重ね、手下を集めた。", "revealedBy": ["maul-shadow-lord"] },
      { "text": "[[pyke-syndicate]]や[[crimson-dawn]]を、自分の不幸で肥えた者として狙った。", "revealedBy": ["maul-shadow-lord"] },
      { "text": "牢にいた[[devon-izara]]を見つけ、連れ去った。", "revealedBy": ["maul-shadow-lord"] },
      { "text": "自らを鍛えたのは[[darth-sidious]]だと明かした。", "revealedBy": ["maul-shadow-lord"] },
      { "text": "[[darth-vader]]と刃を交え、建物を崩して逃れた。", "revealedBy": ["maul-shadow-lord"] },
      { "text": "[[dryden-vos]]と手を結んだ。", "revealedBy": ["maul-shadow-lord"] }
    ]
  },
